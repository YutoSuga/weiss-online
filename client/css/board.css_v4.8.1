/* =========================================================
   weiss-online board.css v4.8.1
   index.html v3.1 専用・全置換版

   目的:
   - 過去バージョンとのCSS競合を解消する
   - 各エリアの位置被りをなくす
   - 細かなデザイン調整前の安定した土台を作る
   ========================================================= */


/* =========================================================
   1. Variables
   ========================================================= */

:root {
  /* Colors */
  --bg-app: #111827;
  --bg-header: #020617;
  --bg-panel: #1f2937;
  --bg-zone: rgba(17, 24, 39, 0.82);

  --text-main: #f9fafb;
  --text-muted: #d1d5db;

  --border-main: #4b5563;
  --border-zone: #6b7280;
  --border-card: #9ca3af;

  --self-color: #1d4ed8;
  --self-bg: rgba(30, 64, 175, 0.28);

  --opponent-color: #991b1b;
  --opponent-bg: rgba(127, 29, 29, 0.28);

  /* App size */
  --header-height: 48px;
  --left-sidebar-width: 250px;
  --right-sidebar-width: 280px;

  /* Card size */
  --card-width: 72px;
  --card-height: 100px;

  --hand-card-width: 64px;
  --hand-card-height: 90px;

  /* Spacing */
  --page-gap: 12px;
  --section-gap: 14px;
  --zone-gap: 10px;
  --card-gap: 10px;

  /* Playmat columns */
  --resource-column-width: 142px;
  --utility-column-width: 128px;
  --utility-area-width:
    calc(
      var(--utility-column-width) * 2
      + var(--zone-gap)
    );

  /* Center */
  --stage-width:
    calc(
      var(--card-width) * 3
      + var(--card-gap) * 2
      + 24px
    );

  --stage-height:
    calc(
      var(--card-height) * 2
      + var(--card-gap)
      + 32px
    );

  --clock-width: var(--stage-width);
  --clock-height:
    calc(
      var(--card-height)
      + 28px
    );

  /* Hand */
  --hand-width:
    calc(
      var(--hand-card-width) * 7
      + var(--card-gap) * 6
      + 28px
    );

  --hand-height:
    calc(
      var(--hand-card-height)
      + 28px
    );

  /* Overlap */
  --clock-overlap: 30px;
  --level-overlap: 18px;
  --stock-overlap: 18px;
}


/* =========================================================
   2. Reset / Base
   ========================================================= */

* {
  box-sizing: border-box;
}

html {
  min-width: 1440px;
  background: var(--bg-app);
}

body {
  margin: 0;
  min-width: 1440px;
  min-height: 100vh;

  overflow-x: auto;
  overflow-y: auto;

  background: var(--bg-app);
  color: var(--text-main);

  font-family:
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
}

h1,
h2,
h3,
p,
ul,
ol,
dl,
dd {
  margin: 0;
}

ul,
ol {
  padding-left: 20px;
}


/* =========================================================
   3. App Frame
   ========================================================= */

.app-header {
  position: sticky;
  top: 0;
  z-index: 100;

  height: var(--header-height);
  padding: 8px 16px;

  border-bottom: 1px solid #374151;
  background: var(--bg-header);
}

.app-header h1 {
  font-size: 20px;
  line-height: 32px;
}

.app-layout {
  display: grid;
  grid-template-columns:
    var(--left-sidebar-width)
    minmax(800px, 1fr)
    var(--right-sidebar-width);

  gap: var(--page-gap);
  align-items: start;

  min-height: calc(100vh - var(--header-height));
  padding: var(--page-gap);
}


/* =========================================================
   4. Sidebars
   ========================================================= */

.left-sidebar,
.right-sidebar {
  display: flex;
  flex-direction: column;
  gap: var(--page-gap);

  min-width: 0;
}

.info-panel {
  padding: 12px;

  border: 1px solid var(--border-main);
  border-radius: 8px;

  background: var(--bg-panel);
}

.info-panel h2 {
  margin-bottom: 10px;
  font-size: 16px;
}

.log-panel {
  min-height: 240px;
}

.card-detail-panel {
  min-height: 320px;
}

.player-status-list,
.room-status-list {
  display: grid;
  gap: 5px;
}

.player-status-item,
.room-status-item {
  display: grid;
  grid-template-columns: 78px minmax(0, 1fr);
  gap: 8px;

  font-size: 13px;
}

.player-status-item dt,
.room-status-item dt {
  color: var(--text-muted);
}

.player-status-item dd,
.room-status-item dd {
  margin: 0;
  text-align: right;
}

.game-log {
  font-size: 13px;
}

.end-turn-button {
  width: 100%;
  height: 56px;

  border: 0;
  border-radius: 8px;

  background: #2563eb;
  color: #ffffff;

  font-size: 18px;
  font-weight: 700;

  cursor: pointer;
}

.end-turn-button:hover {
  background: #1d4ed8;
}


/* =========================================================
   5. Game Board
   ========================================================= */

.game-board {
  display: flex;
  flex-direction: column;
  gap: var(--section-gap);

  min-width: 0;
}

.player-section {
  display: flex;
  flex-direction: column;
  gap: var(--zone-gap);

  min-width: 0;
  padding: 12px;

  border: 2px solid var(--border-main);
  border-radius: 12px;
}

.opponent-section {
  background: var(--opponent-bg);
  border-color: var(--opponent-color);
}

.self-section {
  background: var(--self-bg);
  border-color: var(--self-color);
}


/* =========================================================
   6. Hand
   ========================================================= */

.hand-area {
  position: relative;

  display: flex;
  flex-direction: column;

  width: var(--hand-width);
  min-height: var(--hand-height);
  align-self: center;

  padding: 8px 12px;

  border: 1px solid var(--border-zone);
  border-radius: 8px;

  background: var(--bg-zone);
}

.hand-slots {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: var(--card-gap);

  width: 100%;
  min-height: var(--hand-card-height);
}

.hand-area .card-slot {
  width: var(--hand-card-width);
  height: var(--hand-card-height);
}


/* =========================================================
   7. Playmat Base
   ========================================================= */

.playmat {
  display: grid;
  gap: var(--section-gap);

  justify-content: center;
  align-items: stretch;

  min-width: 0;
}

/*
  相手:
  左   = 控え室・山札・思い出
  中央 = クロック・舞台
  右   = レベル・クライマックス・ストック
*/
.opponent-playmat {
  grid-template-columns:
    var(--resource-column-width)
    var(--stage-width)
    var(--utility-area-width);
}

/*
  自分:
  左   = ストック・クライマックス・レベル
  中央 = 舞台・クロック
  右   = 思い出・山札・控え室
*/
.self-playmat {
  grid-template-columns:
    var(--utility-area-width)
    var(--stage-width)
    var(--resource-column-width);
}

.playmat-center {
  display: flex;
  flex-direction: column;
  gap: var(--zone-gap);

  width: var(--stage-width);
  min-width: var(--stage-width);
}

.playmat-side {
  min-width: 0;
}


/* =========================================================
   8. Resource Side
   控え室・山札・思い出
   ========================================================= */

.opponent-playmat > .side-left,
.self-playmat > .side-right {
  display: flex;
  flex-direction: column;
  gap: var(--zone-gap);

  width: var(--resource-column-width);
}

/* 相手側は下端寄せ */
.opponent-playmat > .side-left {
  justify-content: flex-end;
}

/* 自分側は上端寄せ */
.self-playmat > .side-right {
  justify-content: flex-start;
}

.waiting-room-zone,
.deck-zone {
  width: var(--resource-column-width);
  min-height: 118px;
}

.memory-zone {
  width: var(--resource-column-width);
  min-height: 82px;
}


/* =========================================================
   9. Utility Side
   レベル・クライマックス・ストック
   ========================================================= */

.opponent-playmat > .side-right,
.self-playmat > .side-left {
  display: grid;
  grid-template-columns:
    var(--utility-column-width)
    var(--utility-column-width);

  gap: var(--zone-gap);

  width: var(--utility-area-width);
}

/*
  相手側

  レベル            空き
  クライマックス    ストック
*/
.opponent-playmat > .side-right {
  grid-template-rows: 134px minmax(250px, 1fr);
}

.opponent-playmat > .side-right .level-zone {
  grid-column: 1;
  grid-row: 1;

  align-self: start;
}

.opponent-playmat > .side-right .climax-zone {
  grid-column: 1;
  grid-row: 2;

  align-self: end;
}

.opponent-playmat > .side-right .stock-zone {
  grid-column: 2;
  grid-row: 1 / span 2;

  align-self: stretch;
}

/*
  自分側

  ストック    クライマックス
  ストック    レベル
*/
.self-playmat > .side-left {
  grid-template-rows: minmax(250px, 1fr) 134px;
}

.self-playmat > .side-left .stock-zone {
  grid-column: 1;
  grid-row: 1 / span 2;

  align-self: stretch;
}

.self-playmat > .side-left .climax-zone {
  grid-column: 2;
  grid-row: 1;

  align-self: start;
}

.self-playmat > .side-left .level-zone {
  grid-column: 2;
  grid-row: 2;

  align-self: end;
}

.stock-zone,
.climax-zone,
.level-zone {
  width: var(--utility-column-width);
}

.climax-zone,
.level-zone {
  min-height: 122px;
}

.stock-zone {
  min-height:
    calc(
      var(--stage-height)
      + var(--clock-height)
      + var(--zone-gap)
    );
}


/* =========================================================
   10. Zone Common
   ========================================================= */

.zone {
  position: relative;

  display: flex;
  flex-direction: column;

  min-width: 0;
  padding: 6px;

  border: 1px solid var(--border-zone);
  border-radius: 8px;

  background: var(--bg-zone);
}

.zone-body {
  position: relative;
  z-index: 2;

  display: flex;
  justify-content: center;
  align-items: center;

  flex: 1;

  min-width: 0;
  min-height: 0;
}

.zone-title {
  position: relative;
  z-index: 1;

  color: #e5e7eb;

  font-size: 12px;
  font-weight: 700;

  pointer-events: none;
}


/* =========================================================
   11. Card Slot
   ========================================================= */

.card-slot {
  display: flex;
  justify-content: center;
  align-items: center;

  width: var(--card-width);
  height: var(--card-height);
  flex-shrink: 0;

  border: 1px solid var(--border-card);
  border-radius: 6px;

  background: #f9fafb;
  color: #111827;

  font-size: 12px;
  text-align: center;

  transform-origin: center;
}

[data-face="down"] {
  background:
    repeating-linear-gradient(
      45deg,
      #1f2937,
      #1f2937 8px,
      #374151 8px,
      #374151 16px
    );

  color: #f9fafb;
}


/* =========================================================
   12. Stage
   ========================================================= */

.stage-area {
  width: var(--stage-width);
  min-height: var(--stage-height);
}

.stage-body {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: var(--card-gap);

  width: 100%;
}

.stage-row {
  display: flex;
  align-items: center;

  width: 100%;
  min-height: var(--card-height);
}

/* 前列3枚 */
.stage-row.front-row {
  justify-content: center;
  gap: var(--card-gap);
}

/*
  後列2枚は中央を挟んで配置。
  細かい位置は次バージョンで調整する。
*/
.stage-row.back-row {
  justify-content: center;
  gap: var(--card-width);
}

/* 舞台カードだけdata-positionを表示に反映 */
.stage-slot[data-position="stand"] {
  transform: rotate(0deg);
}

.stage-slot[data-position="rest"] {
  transform: rotate(90deg);
}

.stage-slot[data-position="reverse"] {
  transform: rotate(180deg);
}


/* =========================================================
   13. Clock
   ========================================================= */

.clock-zone {
  width: var(--clock-width);
  min-height: var(--clock-height);
}

.clock-slots {
  display: flex;
  justify-content: center;
  align-items: center;

  width: 100%;
}

.clock-slots .card-slot {
  position: relative;
  margin-right: calc(var(--clock-overlap) * -1);
}

.clock-slots .card-slot:last-child {
  margin-right: 0;
}

/* 相手クロックの重なり順 */
.opponent-clock [data-index="1"] {
  z-index: 1;
}

.opponent-clock [data-index="2"] {
  z-index: 2;
}

.opponent-clock [data-index="3"] {
  z-index: 3;
}

.opponent-clock [data-index="4"] {
  z-index: 4;
}

.opponent-clock [data-index="5"] {
  z-index: 5;
}

.opponent-clock [data-index="6"] {
  z-index: 6;
}


/* =========================================================
   14. Level
   ========================================================= */

.level-slots {
  position: relative;

  display: block;

  width: 100%;
  min-height: 104px;
}

.level-slots .card-slot {
  position: absolute;
  left: 50%;

  transform:
    translateX(-50%)
    rotate(90deg);
}

/* 相手：上から0、1、2、3 */
.opponent-playmat .level-slots [data-index="1"] {
  top: 0;
  z-index: 1;
}

.opponent-playmat .level-slots [data-index="2"] {
  top: var(--level-overlap);
  z-index: 2;
}

.opponent-playmat .level-slots [data-index="3"] {
  top: calc(var(--level-overlap) * 2);
  z-index: 3;
}

.opponent-playmat .level-slots [data-index="4"] {
  top: calc(var(--level-overlap) * 3);
  z-index: 4;
}

/* 自分：下から0、その上に1、2、3 */
.self-playmat .level-slots [data-index="1"] {
  bottom: 0;
  z-index: 1;
}

.self-playmat .level-slots [data-index="2"] {
  bottom: var(--level-overlap);
  z-index: 2;
}

.self-playmat .level-slots [data-index="3"] {
  bottom: calc(var(--level-overlap) * 2);
  z-index: 3;
}

.self-playmat .level-slots [data-index="4"] {
  bottom: calc(var(--level-overlap) * 3);
  z-index: 4;
}


/* =========================================================
   15. Climax
   ========================================================= */

.climax-slots {
  justify-content: center;
}

/* 相手は下寄せ */
.opponent-playmat .climax-slots {
  align-items: flex-end;
}

/* 自分は上寄せ */
.self-playmat .climax-slots {
  align-items: flex-start;
}

.climax-slots .card-slot {
  transform: rotate(90deg);
}


/* =========================================================
   16. Stock
   ========================================================= */

.stock-slots {
  position: relative;

  display: block;

  width: 100%;
  min-height: 300px;
}

.stock-slots .card-slot {
  position: absolute;
  left: 50%;

  transform:
    translateX(-50%)
    rotate(90deg);
}

/* 相手：上から下へ */
.opponent-playmat .stock-slots [data-index="1"] {
  top: 0;
  z-index: 1;
}

.opponent-playmat .stock-slots [data-index="2"] {
  top: var(--stock-overlap);
  z-index: 2;
}

.opponent-playmat .stock-slots [data-index="3"] {
  top: calc(var(--stock-overlap) * 2);
  z-index: 3;
}

.opponent-playmat .stock-slots [data-index="4"] {
  top: calc(var(--stock-overlap) * 3);
  z-index: 4;
}

.opponent-playmat .stock-slots [data-index="5"] {
  top: calc(var(--stock-overlap) * 4);
  z-index: 5;
}

.opponent-playmat .stock-slots [data-index="6"] {
  top: calc(var(--stock-overlap) * 5);
  z-index: 6;
}

.opponent-playmat .stock-slots [data-index="7"] {
  top: calc(var(--stock-overlap) * 6);
  z-index: 7;
}

/* 自分：下から上へ */
.self-playmat .stock-slots [data-index="1"] {
  bottom: 0;
  z-index: 1;
}

.self-playmat .stock-slots [data-index="2"] {
  bottom: var(--stock-overlap);
  z-index: 2;
}

.self-playmat .stock-slots [data-index="3"] {
  bottom: calc(var(--stock-overlap) * 2);
  z-index: 3;
}

.self-playmat .stock-slots [data-index="4"] {
  bottom: calc(var(--stock-overlap) * 3);
  z-index: 4;
}

.self-playmat .stock-slots [data-index="5"] {
  bottom: calc(var(--stock-overlap) * 4);
  z-index: 5;
}

.self-playmat .stock-slots [data-index="6"] {
  bottom: calc(var(--stock-overlap) * 5);
  z-index: 6;
}

.self-playmat .stock-slots [data-index="7"] {
  bottom: calc(var(--stock-overlap) * 6);
  z-index: 7;
}


/* =========================================================
   17. Memory / Deck / Waiting Room
   ========================================================= */

.memory-slots .card-slot {
  transform: rotate(90deg);
}

.deck-zone .card-slot,
.waiting-room-zone .card-slot {
  width: 64px;
  height: 90px;
}


/* =========================================================
   18. Play Mode
   ========================================================= */

body.play-mode .zone,
body.play-mode .hand-area {
  padding: 4px;

  border-color: rgba(156, 163, 175, 0.45);
}

/* zone-titleを背景表示 */
body.play-mode .zone-title {
  position: absolute;
  inset: 0;
  z-index: 1;

  display: flex;
  justify-content: center;
  align-items: center;

  width: 100%;
  height: 100%;

  color: rgba(255, 255, 255, 0.14);

  font-size: 14px;
  letter-spacing: 0.08em;

  overflow: hidden;
}

body.play-mode .hand-area > .zone-title {
  position: absolute;
  inset: 0;
  z-index: 1;

  display: flex;
  justify-content: center;
  align-items: center;

  color: rgba(255, 255, 255, 0.14);

  font-size: 14px;
  letter-spacing: 0.08em;
}

body.play-mode .zone-body,
body.play-mode .hand-area .zone-body {
  position: relative;
  z-index: 2;
}


/* =========================================================
   19. Debug Mode
   ========================================================= */

body.debug-mode .zone,
body.debug-mode .hand-area {
  padding: 8px;

  border-color: rgba(229, 231, 235, 0.8);
}

body.debug-mode .zone-title,
body.debug-mode .hand-area > .zone-title {
  position: static;

  display: block;

  width: auto;
  height: auto;
  margin-bottom: 6px;

  color: #e5e7eb;

  font-size: 12px;
  letter-spacing: normal;
}


/* =========================================================
   20. Debug Card Text
   ========================================================= */

.card-slot:empty::after {
  content:
    attr(data-zone)
    " "
    attr(data-index);

  font-size: 10px;
  opacity: 0.35;
}

body.debug-mode .card-slot:empty::after {
  opacity: 0.85;
}